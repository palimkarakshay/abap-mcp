managed implementation in class zbp_r_demo unique;
strict ( 2 );

define behavior for ZR_Demo alias Demo
persistent table zdemo
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  association _Item { create; }
}

define behavior for ZR_DemoItem alias Item
persistent table zdemo_i
lock dependent by _Demo
etag dependent by _Demo
authorization dependent by _Demo
{
  create;
  update;
  association _Demo;
}
